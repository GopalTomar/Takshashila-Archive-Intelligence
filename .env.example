# ============================================================
# Takshashila Archive Intelligence — environment template
# Copy to .env and fill in. NEVER commit .env.
# ============================================================

# ─── Database ──────────────────────────────────────────────
# Production/local (Docker Compose) default:
DATABASE_URL=postgresql+psycopg://takshashila:takshashila@localhost:5432/takshashila
# For quick tests without Postgres you may use SQLite (semantic search falls
# back to Python cosine similarity; FTS falls back to LIKE):
# DATABASE_URL=sqlite+pysqlite:///./data/dev.db

# ─── Background jobs ───────────────────────────────────────
# If REDIS_URL is set, Celery is used. If empty, an in-process runner is used.
REDIS_URL=redis://localhost:6379/0
# Force the simple in-process runner even if Redis is configured:
JOBS_INLINE=false

# ─── Storage ───────────────────────────────────────────────
DATA_DIR=./data

# ─── API server ────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed browser origins (CORS). Do NOT use "*".
CORS_ORIGINS=http://localhost:3000
# Max download size for the crawler/fetcher, in megabytes:
MAX_DOWNLOAD_MB=200
# Secret used to encrypt provider API keys at rest in the DB (settings store).
# Generate one with: python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-generate-a-long-random-value

# ─── AI providers (server-side ONLY — never exposed to browser) ─────
# Groq (OpenAI-compatible). Base URL is fixed by the provider.
GROQ_API_KEY=
# OpenAI
OPENAI_API_KEY=
# Anthropic (future integration)
ANTHROPIC_API_KEY=
# Generic OpenAI-compatible endpoint (OpenRouter, vLLM, LM Studio, ...)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

# ─── Embeddings (independent from the chat model) ──────────
# Provider: none | openai | openai_compatible | local | hash
# "hash" is a deterministic offline embedding for tests/demo (clearly labelled,
# NOT a real semantic model). "none" disables semantic search entirely.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=32

# ─── Frontend ──────────────────────────────────────────────
# The browser talks only to the API; the API talks to providers.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
